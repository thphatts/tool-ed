# Sao chép tệp này thành .env. Không commit .env lên Git.

# English Discoveries account
ED_URL="https://your-english-discoveries-host.example/your-institution#/home"
ED_USERNAME=""
ED_PASSWORD=""
ED_STORAGE_STATE="session_state.json"
ED_OUTPUT_DIR="run_artifacts"

# Chỉ cấu hình khi DNS thông thường không hoạt động. Ví dụ cú pháp:
# ED_HOST_RESOLVER_RULES="MAP host.example 203.0.113.10,MAP *.example 203.0.113.10"
ED_HOST_RESOLVER_RULES=""

# AI providers (tùy chọn)

# 1. GEMINI API KEYS (Hỗ trợ nhiều key cách nhau bởi dấu phẩy để tự động xoay tua khi 429 / hết quota)
# Đăng ký key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_BACKUP_KEYS=""

# 2. GROQ API KEY (Dự phòng siêu tốc, miễn phí 14,400 req/ngày, cực kỳ thông minh)
# Đăng ký miễn phí tại: https://console.groq.com/keys
GROQ_API_KEY=""

# 3. OPENROUTER API KEY (Dự phòng nhiều model)
# Đăng ký tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# 4. OPENAI API KEY (Nếu có)
OPENAI_API_KEY=""

# Ollama local (tùy chọn)
OLLAMA_API_URL="http://localhost:11434/v1"
OLLAMA_MODEL=""
